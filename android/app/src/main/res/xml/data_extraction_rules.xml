<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以上的自動備份與換機搬移規則,內容同 backup_rules.xml。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="db/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="db/" />
    </device-transfer>
</data-extraction-rules>
